name = "weathered-dream-8f83"
main = "worker.js"
compatibility_date = "2026-07-01"
preview_urls = false

[[kv_namespaces]]
binding = "LEADERBOARD_KV"
id = "replace-with-your-kv-namespace-id"

[vars]
# Comma-separate production and local origins.
CORS_ALLOW_ORIGIN = "https://your-site.example.com,http://localhost:3000,http://127.0.0.1:3000"

# Set secrets with:
# wrangler secret put ADMIN_API_TOKEN
# wrangler secret put TURNSTILE_SECRET_KEY

[observability]
enabled = true

[observability.logs]
enabled = true
